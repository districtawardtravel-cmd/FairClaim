# Google Generative AI API Key
VITE_GOOGLE_API_KEY=your_api_key_here

# Email Service (Gmail App Password recommended)
VITE_EMAIL_SERVICE=gmail
VITE_SENDER_EMAIL=your_email@gmail.com
VITE_SENDER_PASSWORD=your_app_password

# Backend endpoint for email sending (optional self-hosted)
VITE_BACKEND_URL=http://localhost:3000

# Airline policy database API
VITE_POLICY_API_KEY=your_airline_policy_api_key
